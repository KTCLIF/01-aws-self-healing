resource_prefix = "p01-self-healing"
aws_profile     = "p1-personal"
region          = "ap-northeast-2"
vpc_cidr        = "10.40.0.0/16"

# Supply securely with TF_VAR_expected_account_id or an ignored terraform.tfvars.
# Never commit an actual account ID.

# Keep none for local validation. Other modes create billable resources on apply.
# instance_ha is a low-cost learning/failure-recovery experiment.
# gateway_per_az is the lower-operations production reference.
nat_mode = "none"

# ALB and two EC2 instances are billable and remain disabled until an approved AWS experiment.
enable_web_asg   = false
web_instance_type = "t3.micro"
web_ingress_cidrs = ["203.0.113.10/32"]
